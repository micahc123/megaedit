#!/bin/sh
# Megaedit for Claude Code: the launcher (macOS, Linux, and Windows through Git Bash; on Windows megaedit.exe next
# to this file runs it with Git Bash, because Claude Code starts MCP servers without a shell).
# The plugin repo stays small. The engine (renderer, styles, sound library, its own Node) is a GitHub release
# asset: the first run downloads the one for this computer, checks its SHA-256 against engine.lock, and unpacks it to
# ~/.megaedit/plugin-engine/<version>-<platform>/. After that this script just starts it.
#   megaedit <command>     run a Megaedit command (megaedit help)
#   megaedit install       download the engine now (waits for it)
# Testing before a release: MEGAEDIT_ENGINE_FILE=<local .tar.gz> (still checksum-checked).
# All messages go to stderr: stdout belongs to the MCP server and the hooks.

BIN_DIR=$(cd "$(dirname "$0")" && pwd -P)
ROOT=$(dirname "$BIN_DIR")
LOCK_FILE="$ROOT/engine.lock"
CR=$(printf '\r')
say() { printf '%s\n' "$*" >&2; }
# engine.lock values (a checkout with Windows line endings still reads cleanly)
get() { sed -n "s/^$1=//p" "$LOCK_FILE" | head -n 1 | tr -d '\r'; }

[ -f "$LOCK_FILE" ] || { say "Megaedit: engine.lock is missing from the plugin. Reinstall it: /plugin install megaedit@megamedia-labs"; exit 1; }
VER=$(get version)
URL=$(get url)

OS=$(uname -s); ARCH=$(uname -m)
if [ "$OS" = Darwin ] && [ "$ARCH" = x86_64 ] && [ "$(sysctl -n sysctl.proc_translated 2>/dev/null)" = 1 ]; then ARCH=arm64; fi
WIN=
case "$OS-$ARCH" in
  Darwin-arm64) PLAT=darwin-arm64 ;;
  Darwin-x86_64) PLAT=darwin-x64 ;;
  Linux-x86_64|Linux-amd64) PLAT=linux-x64 ;;
  MINGW*-*|MSYS*-*|CYGWIN*-*)
    # Git Bash. Windows on Arm runs the x64 engine through its emulator.
    PLAT=win32-x64; WIN=1
    command -v sed >/dev/null 2>&1 || PATH="/usr/bin:/mingw64/bin:$PATH" ;;
  *) say "Megaedit's Claude Code plugin runs on macOS, Windows (x64) and Linux (x64). This computer is $OS $ARCH."; exit 1 ;;
esac
# Native Windows programs (the engine's node.exe) get Windows paths.
native() { if [ -n "$WIN" ] && command -v cygpath >/dev/null 2>&1; then cygpath -m "$1"; else printf '%s' "$1"; fi; }

ENTRY=$(get "$PLAT")
[ -n "$ENTRY" ] || { say "Megaedit $VER has no engine for $PLAT yet. Update the plugin: /plugin marketplace update megamedia-labs, then restart Claude Code."; exit 1; }
FILE=${ENTRY%% *}
SUM=${ENTRY##* }
if [ -n "$WIN" ] && [ -z "${MEGAEDIT_HOME:-}" ] && [ -n "${USERPROFILE:-}" ] && command -v cygpath >/dev/null 2>&1; then
  H="$(cygpath -u "$USERPROFILE")/.megaedit"   # the same folder the engine uses (os.homedir() is USERPROFILE)
else
  H="${MEGAEDIT_HOME:-$HOME/.megaedit}"
fi
DEST="$H/plugin-engine/$VER-$PLAT"
LOCKD="$DEST.installing"
if [ -n "$WIN" ]; then NODE="$DEST/node/node.exe"; else NODE="$DEST/node/bin/node"; fi

sha256_of() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | cut -d' ' -f1
  else shasum -a 256 "$1" | cut -d' ' -f1; fi
}
fetch() {
  if command -v curl >/dev/null 2>&1; then curl -fL --retry 3 --connect-timeout 20 -sS -o "$2" "$1"
  else wget -q -O "$2" "$1"; fi
}

install_engine() {
  mkdir -p "$H/plugin-engine" || return 1
  # One installer at a time (the session hook, the MCP server and a command can all start together).
  waited=0
  while ! mkdir "$LOCKD" 2>/dev/null; do
    [ -f "$DEST/.ok" ] && return 0
    # A live install writes a file every few seconds (download, then unpack). Nothing new for 3 minutes means it was
    # killed (Claude Code closed, the computer slept): take over.
    if [ -z "$(find "$LOCKD" "$DEST.part" -mmin -3 2>/dev/null | head -n 1)" ]; then rm -rf "$LOCKD"; continue; fi
    [ "$waited" -ge "${1:-900}" ] && { say "Megaedit is still installing its engine. Try again in a minute."; return 1; }
    [ "$waited" = 0 ] && say "Megaedit: waiting for the engine install that is already running…"
    sleep 2; waited=$((waited + 2))
  done
  [ -f "$DEST/.ok" ] && { rmdir "$LOCKD"; return 0; }
  TMP="$DEST.part"
  rm -rf "$TMP"; mkdir -p "$TMP"
  SRC="${MEGAEDIT_ENGINE_FILE:-}"
  if [ -z "$SRC" ]; then
    say "Megaedit: downloading the engine for this computer (first run only, $(get "size_$PLAT"))…"
    if ! fetch "$URL/$FILE" "$TMP/engine.tar.gz"; then
      say "Megaedit couldn't download its engine from $URL/$FILE. Check the internet connection and try again."
      rm -rf "$TMP" "$LOCKD"; return 1
    fi
    SRC="$TMP/engine.tar.gz"
  fi
  GOT=$(sha256_of "$SRC")
  if [ "$GOT" != "$SUM" ]; then
    say "Megaedit: the engine download didn't match its checksum, so it was not installed. Try again; if it keeps happening, update the plugin (/plugin marketplace update megamedia-labs)."
    rm -rf "$TMP" "$LOCKD"; return 1
  fi
  if ! tar -xzmf "$SRC" -C "$TMP" 2>/dev/null; then say "Megaedit couldn't unpack its engine (is the disk full?)."; rm -rf "$TMP" "$LOCKD"; return 1; fi
  rm -f "$TMP/engine.tar.gz"
  touch "$TMP/.ok"
  rm -rf "$DEST"
  # Windows: a virus scanner may still be reading the new files; the rename succeeds a moment later.
  n=0; until mv "$TMP" "$DEST" 2>/dev/null; do n=$((n + 1)); [ "$n" -ge 15 ] && { say "Megaedit couldn't finish installing its engine (a file is in use). Try again."; rm -rf "$LOCKD"; return 1; }; sleep 2; done
  rmdir "$LOCKD" 2>/dev/null
  # Engines from older plugin versions, unused for a day.
  find "$H/plugin-engine" -mindepth 1 -maxdepth 1 -type d -name "*-$PLAT" ! -name "$VER-$PLAT" -mtime +1 -exec rm -rf {} + 2>/dev/null
  say "Megaedit: engine $VER ready."
  return 0
}

run_engine() {
  export MEGAEDIT_PLUGIN=1
  MEGAEDIT_PLUGIN_DIR=$(native "$ROOT"); export MEGAEDIT_PLUGIN_DIR
  MEGAEDIT_ENGINE_BUNDLE=$(native "$DEST/engine-bundle"); export MEGAEDIT_ENGINE_BUNDLE
  MEGAEDIT_STYLES_DIR=$(native "$DEST/styles"); export MEGAEDIT_STYLES_DIR
  MEGAEDIT_LIBRARY_DIR=$(native "$DEST/library"); export MEGAEDIT_LIBRARY_DIR
  exec "$NODE" "$(native "$DEST/cli/node_modules/@megaedit/cli/dist/bin.js")" "$@"
}

# First session: Claude Code gives an MCP server about 30 s to answer, and the engine is ~300 MB. So this stub answers
# the handshake (and an empty tool list) at once, installs the engine meanwhile, then hands the session to the real
# server (replaying the handshake to it) and tells Claude Code the tool list changed. No restart needed.
reply() { printf '{"jsonrpc":"2.0","id":%s,"result":%s}\n' "$1" "$2"; }
mcp_stub() {
  install_engine 1800 >/dev/null 2>&1 &
  IPID=$!
  INIT=; INITD=; LISTED=
  while IFS= read -r line; do
    line=${line%"$CR"}
    l=$(printf '%s' "$line" | sed 's/"[[:space:]]*:[[:space:]]*/":/g')
    id=$(printf '%s' "$l" | sed -nE 's/.*"id":(-?[0-9]+|"[^"]*").*/\1/p')
    case "$l" in
      *'"method":"initialize"'*)
        INIT=$line
        pv=$(printf '%s' "$l" | sed -nE 's/.*"protocolVersion":"([^"]*)".*/\1/p')
        reply "$id" "{\"protocolVersion\":\"${pv:-2025-06-18}\",\"capabilities\":{\"tools\":{\"listChanged\":true},\"prompts\":{}},\"serverInfo\":{\"name\":\"megaedit\",\"version\":\"$VER\"},\"instructions\":\"Megaedit is installing its engine on this computer (first run, a minute or two). Its tools appear here as soon as it is ready. Every Megaedit tool needs a Megamedia Labs member key (/megaedit:login <key>). ElevenLabs voice uses the member's own key (/megaedit:voice-key <key>).\"}" ;;
      *'"method":"notifications/initialized"'*) INITD=$line ;;
      *'"method":"tools/list"'*) reply "$id" '{"tools":[]}'; LISTED=1; break ;;
      *'"method":"prompts/list"'*) reply "$id" '{"prompts":[]}' ;;
      *'"method":"resources/list"'*) reply "$id" '{"resources":[]}' ;;
      *'"method":"resources/templates/list"'*) reply "$id" '{"resourceTemplates":[]}' ;;
      *'"method":"ping"'*) reply "$id" '{}' ;;
      *'"method":"notifications/'*) ;;
      *) [ -n "$id" ] && printf '{"jsonrpc":"2.0","id":%s,"error":{"code":-32002,"message":"Megaedit is still installing its engine. Try again in a minute."}}\n' "$id" ;;
    esac
  done
  # Claude Code closed the session before asking for tools: nothing to hand over (the install carries on).
  [ -n "$LISTED" ] && [ -n "$INIT" ] || exit 0
  if ! wait "$IPID" || [ ! -f "$DEST/.ok" ]; then
    say "Megaedit couldn't install its engine. Run /megaedit:setup to see why."
    exit 1
  fi
  # The real server gets the member's handshake again; its answer to it is dropped (the client already has one).
  { printf '%s\n' "$INIT"; [ -n "$INITD" ] && printf '%s\n' "$INITD"; exec cat; } | run_engine mcp | {
    while IFS= read -r out; do case "$out" in *'"protocolVersion"'*) break ;; *) printf '%s\n' "$out" ;; esac; done
    printf '%s\n' '{"jsonrpc":"2.0","method":"notifications/tools/list_changed"}'
    exec cat
  }
  exit $?
}

if [ ! -f "$DEST/.ok" ]; then
  case "${1:-}" in
    hook)
      # Never hold up the start of a session: install in the background and say so.
      ( install_engine >/dev/null 2>&1 & )
      if [ "${2:-}" = session-start ]; then
        printf '%s\n' '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"Megaedit is installing its engine on this computer (first run, a minute or two). Megaedit commands wait for it, and its tools appear in this session when it is ready. If they are still missing after that, run /megaedit:setup, then /mcp and reconnect megaedit."}}'
      fi
      exit 0 ;;
    mcp) mcp_stub ;;
    # The slash commands run gate/login/voice-key inline: exit 0 so the member sees the message, not a shell error.
    gate|login|voice-key) install_engine || exit 0 ;;
    *) install_engine || exit 1 ;;
  esac
fi
[ "${1:-}" = install ] && { say "Megaedit: engine $VER is installed at $(native "$DEST")"; exit 0; }
run_engine "$@"
