  "hook": "I found a note in the pocket of a coat I bought for ten dollars.",
  "scenes": [
    {
      "id": "s01",
      "text": "I found a note in the pocket of a coat I bought for ten dollars.",
      "visual": {
        "layout": "title",
        "headline": "The note in the old coat",
        "subhead": "a very short story",
