          },
          {
            "kind": "house"
          }
        ],
        "setting": "map",
        "camera": "pan-right",
        "transition": "cut"
      }
    },
    {
      "id": "s05",
      "text": "A shop owner said, you are the third person to ask me about that coat.",
      "visual": {
        "layout": "dialogue",
        "characters": [
          {
            "ref": "mabel",
            "pose": "shock",
            "position": "left",
            "line": "The third?"
          },
          {
            "ref": "ferris",
            "pose": "talk",
            "position": "right",
            "line": "People keep finding it."
