        "transition": "cut",
        "emphasis": [
          "years"
        ]
      }
    },
    {
      "id": "s03",
      "text": "It said, in blue ink, meet me where the trams turn around.",
      "visual": {
        "layout": "quote",
        "setting": "newsprint",
        "camera": "static",
        "transition": "cut",
        "quote": {
          "text": "Meet me where the trams turn around.",
          "who": "unsigned"
        }
      }
    },
    {
      "id": "s04",
      "text": "So I went, and the old map at the stop had one street scratched out.",
      "visual": {
        "layout": "split",
        "headline": "Then and now",
        "items": [
          "The old map",
          "The street today"
        ],
        "props": [
          {
