        "camera": "push-in",
        "transition": "cut"
      }
    },
    {
      "id": "s02",
      "text": "The first ones all did the same thing. They nosedived straight into my cereal.",
      "visual": {
        "layout": "hero",
        "headline": "Nosedive",
        "characters": [
          {
            "ref": "wren",
            "pose": "shock",
            "position": "left"
