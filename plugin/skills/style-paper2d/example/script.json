{
  "title": "The paper plane that flies",
  "hook": "I folded forty paper planes before one actually flew.",
  "scenes": [
    {
      "id": "s01",
      "text": "I folded forty paper planes before one actually flew.",
      "visual": {
        "layout": "title",
        "headline": "The plane that flew",
        "subhead": "fold number forty-one",
        "characters": [
          {
            "ref": "wren",
